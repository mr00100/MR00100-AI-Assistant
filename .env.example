# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional — enables the heavy AI engine
OPENROUTER_API_KEY=

# Optional model overrides (never hard-coded in app logic)
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_DEVELOPER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_REASONING_MODEL=openai/gpt-4o
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct

# Optional sandbox root for the MR00100 workspace (not the whole PC)
# MR00100_WORKSPACE=C:\Users\Public\mr00100-workspace
